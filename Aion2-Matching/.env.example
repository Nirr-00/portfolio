# ==============================================================================
# Aion2-Matching Environment Variables Example (.env.example)
# ==============================================================================
# 로컬 개발 및 실행 시 이 파일을 복사하여 `.env.local`을 생성하고 실제 값으로 대체하세요.
# 주의: SUPABASE_SERVICE_ROLE_KEY는 서버 전용 관리자 키이므로 절대 외부에 커밋하지 마세요.

# [공개 클라이언트 환경 변수]
# Supabase 프로젝트 URL (브라우저 및 서버 공용)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon API Key (브라우저 및 서버 공용 공개 키, RLS 적용)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-placeholder

# [서버 전용 비밀 환경 변수]
# Supabase Service Role Key (Server Actions / 관리자 권한 전용, 클라이언트 번들에 절대 포함 금지)
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key-secret
